NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never expose to the browser.
# Supabase Dashboard → Project Settings → API Keys → Secret keys
# (legacy name: service_role key; same capability, new UI naming).
SUPABASE_SECRET_KEY=

# Resend → notifications.winlab.tw. Auto-synced via Vercel integration in prod.
RESEND_API_KEY=

# Shared secret between Vercel Cron and the cron route handler.
# Vercel injects `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
CRON_SECRET=

# Public site URL used when rendering links in outgoing emails.
# Defaults to https://portal.winlab.tw if not set.
NEXT_PUBLIC_SITE_URL=

# NextCloud service account for PPT/video uploads from meetings.
# Create an app password under the portal-bot account in NextCloud Settings → Security.
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=

# Shared secret for the bulletin board notification API.
# Used by Google Apps Script to fetch unnotified announcements and mark them sent.
# Generate with: openssl rand -hex 32
BULLETIN_API_SECRET=

# Shared secret for the meetings schedule API.
# Used by the Google Apps Script reminder mailer to fetch the schedule without a
# login cookie. Send as `Authorization: Bearer $MEETINGS_API_SECRET`.
# Generate with: openssl rand -hex 32
MEETINGS_API_SECRET=

# Lab door relay (ESP32-C3 behind door.winlab.tw). /door calls it server-side
# with `Authorization: Bearer $DOOR_API_SECRET`. Server-only, never exposed to
# the browser. When unset, /door renders a "not configured" notice.
DOOR_API_URL=
DOOR_API_SECRET=

# Optional. The lab's 32x32 LED panel bridge (display.winlab.tw, a service on
# the lab pve host that drives the panel over BLE; separate from the door
# relay, with its own token). After a successful /door unlock the portal posts
# the member's name to it with `Authorization: Bearer $DISPLAY_API_SECRET`.
# Server-only, never exposed to the browser. When unset, the unlock works as
# before and nothing is shown.
DISPLAY_API_URL=
DISPLAY_API_SECRET=

# hams-bridge, the lab-side HTTP wrapper around the Hundure RAC-960PME access
# controller. /door/admin calls it server-side with
# `Authorization: Bearer $HAMS_API_SECRET` to list, add, rename and delete
# cards. The controller speaks a binary TCP protocol and only answers on the
# lab network, which is why Vercel goes through the bridge. Server-only, never
# exposed to the browser. When unset, /door/admin shows the stored card list
# and says the bridge is not configured.
HAMS_API_URL=
HAMS_API_SECRET=

# Dedicated ingest-only secret shared with hams-bridge. At least 32 ASCII
# characters. This does not grant card-management or door-unlock access.
HAMS_EVENTS_SECRET=

# Keycloak Admin API, read-only. Used by /profile (showing a member their own
# account fields), /rooms (the attendee picker's group tree) and /meetings (the
# presenter roster's 入學學年 prefill).
#
# The client needs "Service accounts roles" enabled with realm-management →
# view-users, and NOTHING MORE. It deliberately cannot write: members edit
# their own account in Keycloak's Account Console, which is linked from
# /profile. Granting manage-users here would hand this process the ability to
# change any member's email and reset their password — see issue #416 before
# widening it.
#
# Server-only, never exposed to the browser. When unset, the /profile account
# section and the /rooms group picker hide themselves and everything else on
# those pages still works.
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_READ_CLIENT_ID=
KEYCLOAK_READ_CLIENT_SECRET=

# CS dept. meeting room system (portal.winlab.tw/rooms) service account —
# the lab's shared login for that system (NOT SSO, a plain user_id/password
# form). Server-only, never exposed to the browser. When unset, the
# read-only availability calendar still works; only auto-book/auto-cancel
# is disabled.
MEETINGROOM_SERVICE_USER=
MEETINGROOM_SERVICE_PASSWORD=

# Sensorium (sensorium.zyx.tw) observability producer. Unset locally on
# purpose — instrumentation.ts no-ops entirely when this is empty, so plain
# `bun run dev` never tries to export telemetry anywhere.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://sensorium.zyx.tw
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
# OTEL_SERVICE_NAME=portal
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=portal-winlab
