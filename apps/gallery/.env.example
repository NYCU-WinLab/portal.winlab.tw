NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never expose to the browser.
# Supabase Dashboard → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=

# Shared secret for the gallery mention notification API (manual / Apps Script).
# Generate with: openssl rand -hex 32
GALLERY_API_SECRET=

# Vercel Cron auth for /api/cron/mention-emails
CRON_SECRET=

# Resend API key for @mention email delivery
RESEND_API_KEY=

# Public gallery origin used in mention email deep links
NEXT_PUBLIC_SITE_URL=https://gallery.winlab.tw

# Optional local preview when gallery_settings migration is not applied yet.
# Ignored once the DB row exists (Manage picker wins). Values: dragon-boat | world-cup | off
# GALLERY_SEASONAL_THEME=world-cup

# Sensorium (sensorium.zyx.tw) observability producer. Unset locally on
# purpose — instrumentation.ts no-ops entirely when this is empty, so plain
# `bun run dev` never tries to export telemetry anywhere.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://sensorium.zyx.tw
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
# OTEL_SERVICE_NAME=gallery
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=portal-winlab
